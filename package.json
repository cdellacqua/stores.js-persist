{
	"name": "@universal-stores/persist",
	"camelCaseName": "universalStoresPersist",
	"description": "A collection of stores and storage mechanisms for persisting and retrieving data to and from different sources, synchronously or asynchronously.",
	"version": "1.2.1",
	"type": "module",
	"types": "./dist/index.d.ts",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"author": "Carlo Dell'Acqua",
	"license": "MIT",
	"keywords": [
		"persistent",
		"store",
		"storage",
		"localStorage",
		"sessionStorage",
		"fetch",
		"query"
	],
	"repository": {
		"url": "git+https://github.com/cdellacqua/stores.js-persist"
	},
	"bugs": {
		"url": "https://github.com/cdellacqua/stores.js-persist/issues"
	},
	"homepage": "https://github.com/cdellacqua/stores.js-persist",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"coverage": "vitest run --coverage",
		"test": "vitest run",
		"test:watch": "vitest",
		"dev:browser": "vite",
		"dev:node": "tsx watch src/node.ts",
		"build": "vite build --mode lib && vite build --mode umd && vite build --mode node",
		"typecheck": "tsc",
		"doc": "rimraf docs && typedoc --gitRevision main --readme none --plugin typedoc-plugin-markdown src/lib/index.ts",
		"check": "npm run lint && npm run typecheck && npm run test",
		"prepack": "npm run check && npm run build && npm run doc",
		"lint": "eslint --max-warnings 0 .",
		"lint:fix": "eslint --fix .",
		"format": "prettier --check .",
		"format:fix": "prettier --write ."
	},
	"devDependencies": {
		"@types/async-lock": "^1.4.0",
		"@types/jsdom": "^21.1.1",
		"@types/node": "^20.19.39",
		"@typescript-eslint/eslint-plugin": "^8.59.0",
		"@typescript-eslint/parser": "^8.59.0",
		"@vitest/coverage-v8": "^4.1.5",
		"eslint": "^10.2.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"jsdom": "^21.1.1",
		"prettier": "^3.8.3",
		"rimraf": "^6.1.3",
		"tsx": "^4.21.0",
		"typedoc": "^0.28.19",
		"typedoc-plugin-markdown": "^4.11.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.10",
		"vite-plugin-dts": "^4.5.4",
		"vitest": "^4.1.5"
	},
	"dependencies": {
		"@cdellacqua/debounce": "^2.1.2",
		"@cdellacqua/signals": "^5.0.4",
		"async-lock": "^1.4.0",
		"universal-stores": "^2.4.3"
	}
}
